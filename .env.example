# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings > API > JWT Settings > JWT Secret (the "legacy" shared
# secret). Signing Telegram-derived sessions with this exact value is what
# lets Supabase accept them as authenticated requests — see lib/supabase/jwt.ts.
SUPABASE_JWT_SECRET=your-project-jwt-secret

# Telegram — @BotFather
TELEGRAM_BOT_TOKEN=123456:your-bot-token

# Session cookie signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Public app URL (used for absolute links, e.g. share/QR in later phases)
NEXT_PUBLIC_APP_URL=http://localhost:3000
