# ---------------------------------------------------------------------------
# Wedding Registry environment variables
# Copy this file to .env.local for local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public Supabase project URL.
# Example: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anon key. Safe to expose because RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only Supabase service role key.
# Used only in trusted API routes for profile upsert and operational logging.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Supabase JWT secret from Project Settings > API > JWT Settings.
# Used to sign short-lived Telegram-derived Supabase access tokens.
SUPABASE_JWT_SECRET=replace-with-at-least-32-characters

# Telegram bot token from BotFather.
# Used to verify Telegram Mini App initData.
TELEGRAM_BOT_TOKEN=123456:replace-with-telegram-bot-token

# Secret for signing the first-party wr_session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-characters

# Optional comma-separated Telegram user IDs that become Super Admin on login.
# Use only for first production bootstrap, for example: 7990560340
BOOTSTRAP_SUPER_ADMIN_TELEGRAM_IDS=

# Optional public app URL for absolute links and future share/QR flows.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local-only demo mode.
# Set to true only when you want to run the full UI locally without Telegram/Supabase.
NEXT_PUBLIC_LOCAL_DEMO=false
